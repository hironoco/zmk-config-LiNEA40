#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 6
#define WIRELESS 7

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&mkp_input_listener { input-processors = <&zip_temp_layer 5 800>; };

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転,,,,,,,,,,,,,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        wireless {
            bindings = <&mo 7>;
            key-positions = <36 35>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &kp Q      &kp U   &kp L   &kp KP_NUM                                         &kp F        &kp W  &kp R   &kp Y          &kp P
&kp E      &kp I      &kp A   &kp O   &mo 5                                              &kp K        &kp T  &kp N   &kp S          &lt 6 H
&kp Z      &kp X      &kp C   &kp V   &to 1                                              &kp G        &kp D  &kp M   &kp J          &kp B
&kp LCTRL  &kp LSHFT  &trans  &trans  &lt 4 SPACE  &mt LSHIFT LANG2    &mt RSHIFT LANG1  &lt 2 ENTER         &trans  &kp RIGHT_ALT  &kp LWIN
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        GAME {
            bindings = <
&kp ESC         &kp Q       &kp W  &kp E   &kp R                             &trans        &kp NUMBER_1  &kp F         &kp NUMBER_2  &trans
&kp LEFT_SHIFT  &kp A       &kp S  &kp D   &kp Y                             &kp G         &mkp MB1      &mkp MB3      &mkp MB2      &kp TAB
&kp LCTRL       &kp Z       &kp C  &kp V   &kp M                             &kp NUMBER_9  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_7  &kp N8
&kp X           &kp LSHIFT  &to 0  &trans  &kp B  &kp SPACE    &kp LEFT_ALT  &trans                      &trans        &trans        &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        MARK {
            bindings = <
&trans            &kp EXCL   &kp LPAR          &kp RPAR           &kp PERCENT                    &trans  &kp BACKSPACE  &kp UP     &kp DELETE  &trans
&kp SINGLE_QUOTE  &kp COMMA  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp UNDER                      &trans  &kp LEFT       &kp DOWN   &kp RIGHT   &kp AT
&kp GRAVE         &kp SEMI   &kp MINUS         &kp PLUS           &trans                         &trans  &kp AMPERSAND  &kp SLASH  &kp DOLLAR  &kp PERCENT
&trans            &trans     &trans            &trans             &lt 3 TAB    &trans    &trans  &trans                 &trans     &trans      &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_RIGHT SCRL_LEFT>;
        };

        MARK2 {
            bindings = <
&trans             &kp QUESTION  &kp LT     &kp GT     &trans                       &trans  &trans    &trans         &trans    &trans
&kp DOUBLE_QUOTES  &kp PERIOD    &kp LBRC   &kp RBRC   &kp TILDE                    &trans  &kp HOME  &trans         &kp END   &trans
&kp CARET          &kp COLON     &kp EQUAL  &kp ASTRK  &trans                       &trans  &kp PIPE  &kp BACKSLASH  &kp HASH  &trans
&trans             &trans        &trans     &trans     &trans     &trans    &trans  &trans            &trans         &trans    &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_RIGHT SCRL_LEFT>;
        };

        NUMBER {
            bindings = <
&kp SLASH   &kp N7  &kp N8  &kp N9  &trans                    &trans  &kp F12  &kp F11  &kp F10  &kp F9
&kp PERIOD  &kp N4  &kp N5  &kp N6  &trans                    &trans  &kp F8   &kp F7   &kp F6   &kp F5
&kp N0      &kp N1  &kp N2  &kp N3  &trans                    &trans  &kp F4   &kp F3   &kp F2   &kp F1
&trans      &trans  &trans  &trans  &trans  &trans    &trans  &trans           &trans   &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOLUME_DOWN>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans    &trans    &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans  &trans  &trans
            >;
        };

        WIRELESS {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans        &trans        &trans        &studio_unlock  &bootloader
&trans  &trans  &trans  &trans  &trans                    &bt BT_SEL 4  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3
&trans  &trans  &trans  &trans  &trans                    &trans        &trans        &trans        &trans          &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                      &trans        &trans          &bt BT_CLR_ALL
            >;
        };
    };
};
